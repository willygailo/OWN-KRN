# ==============================================================================
# OwnKrn (x86_64 OS Kernel) .gitignore
# ==============================================================================

# Build & staging directories
build/
isodir/
initrd_root/
dist/
out/

# Linux-style Kconfig & auto-generated headers
.config
.config.old
include/generated/

# Compiled objects, dependency files, libraries & linker outputs
*.o
*.obj
*.d
*.dep
*.a
*.so
*.ko
*.mod
*.elf
*.bin
*.map
*.sym
*.lst
*.out
*.dbg

# Coverage & profiling
*.gcda
*.gcno
*.gcov

# Bootable images, initramfs archives & virtual disks (QEMU / VirtIO / ATA)
*.iso
*.img
*.raw
*.qcow
*.qcow2
*.vmdk
*.vdi
*.hdd
initrd*.tar
*.tar.gz
*.tar.xz
*.cpio
*.cpio.gz

# QEMU, GDB, Clipboard Bridge & crash/debug artifacts
qemu.log
serial*.log
gdb.txt
clipboard.txt
*.clip
*.log
*.sock
*.qmp
*.monitor
*.pid
*.pcap
*.pcapng
*.nvram
.gdb_history
core
core.*
*.dmp

# C / C++ / Assembly tooling & symbol indices
.cache/
.clangd/
.ccls-cache/
compile_commands.json
compile_flags.txt
tags
TAGS
cscope.*
GPATH
GRTAGS
GTAGS

# Python & test runner caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# Environment, local overrides & scratch workspaces
.env
.env.*
!.env.example
*.local
*.tmp
*.temp
*.scratch.*
scratch/
tmp/

# Editors, IDEs & local agent metadata
.vscode/
.idea/
*.iml
*.code-workspace
.zed/
.fleet/
.cursor/
.claude/
.agent/
.antigravity/
*.swp
*.swo
*.swn
*~
*.bak
*.orig
*.rej

# OS metadata
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
